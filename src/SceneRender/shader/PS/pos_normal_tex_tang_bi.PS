cbuffer cb0
{
	float4 color;
};

struct PS_INPUT
{
	float4 Position  :		SV_Position;
	float3 NorWorld  :      NORMAL;  //世界坐标系法向量
	float2 Texcoord  :      TEXCOORD0;	//纹理坐标
	float3 RPosWorld :      TEXCOORD1;	//世界坐标系位置
	float3 ItemPos   :      TEXCOORD2;	//原始坐标
	float3 tangent 	 : 		TEXCOORD3;
	float3 binormal  : 		TEXCOORD4;
};

float4 main(in PS_INPUT vIN) : SV_Target
{
	return color;
}

