struct VS_OUTPUT
{
	float4 Position : SV_Position;
	float2 tex : TEXCOORD0;
};


sampler texSample;
Texture2D <float4> left;
Texture2D <float4> right;

float4 main(in VS_OUTPUT vIN) : SV_Target
{
	float4 leftColor = left.Sample(texSample,vIN.tex);
	float4 rightColor = right.Sample(texSample,vIN.tex);
	float4 outColor;  
	outColor.r = leftColor.b ;
	outColor.b = rightColor.r ;
	outColor.g = rightColor.g ;
	outColor.a = (rightColor.a + leftColor.a) / 2 ;

	return outColor;
}

