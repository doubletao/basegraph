struct VS_OUTPUT
{
	float4 Position : SV_Position;
	float3 Normal   : NORMAL;
	float2 tex		: TEXCOORD0;
	float3 posWorld	: TEXCOORD1;
	float3 ItemPos  : TEXCOORD2;
	float3 tangent  : TEXCOORD3;
	float3 binormal : TEXCOORD4;
};

sampler texSample;
Texture2D <float4> tex :register(t0);

#define MSCOUNT 4
Texture2DMS <float4,MSCOUNT> depth:register(t1);;

cbuffer cb0:register(b0)
{
	float offsetx;
	float offsety;
	float scalex;
	float scaley;
	float depthz;
};
struct PS_OUTPUT
{
	float4 color:SV_Target;
};
float4 main(in VS_OUTPUT vIN) :SV_Target
{
	float depthSample = depth.Load( int3( int2( vIN.Position.xy ), 0 ), 0 );
	if(depthz > depthSample)
		discard;
	float2 index;
	index.x = (vIN.Position.x + offsetx) * scalex;
	index.y = (vIN.Position.y + offsety) * scaley;
	float4 color = tex.Sample(texSample,index);
	return color;
}

